# Example environment file for Blaze Score
# Copy this to .env and fill in the values.

# API key for football-data.org (required for that provider)
FOOTBALL_DATA_KEY=your-football-data-key-here

# Optional provider selection – default is 'football-data'
# DATA_PROVIDER=football-data   # other options: espn, demo, api-football

# Free API‑Football key (RapidAPI / API‑Sports). Required only if you use the "api-football" provider.
API_FOOTBALL_KEY=your-api-football-key-here
